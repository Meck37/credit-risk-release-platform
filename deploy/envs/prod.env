APP_ENV=prod
GATEWAY_PORT=8080
# 2.0: at 1.0, bursts of concurrent predictions were CPU-throttled (Step 11 load tests)
API_CPUS=2.0
API_MEMORY=512M
# Canary: share of traffic sent to the new version, and how long to observe it.
CANARY_WEIGHT=10
CANARY_SECONDS=${CANARY_SECONDS:-300}   # override for one run: CANARY_SECONDS=20 scripts/canary.sh ...
CANARY_WINDOW=5m