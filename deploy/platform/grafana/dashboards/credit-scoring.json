{
  "uid": "credit-scoring",
  "title": "Credit Scoring Service",
  "tags": ["mlops", "scoring"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Model version serving",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 4},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "name",
        "colorMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "scoring_model_info",
          "legendFormat": "{{env}}/{{slot}}: v{{model_version}}",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Availability (last 24h)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 4},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 0.99},
              {"color": "green", "value": 0.999}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg by (env) (avg_over_time(probe_success{job=\"availability\"}[24h]))",
          "legendFormat": "{{env}}",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Requests per second",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (env, slot) (rate(http_requests_total{job=\"scoring-api\",handler=\"/v1/score\"}[5m]))",
          "legendFormat": "{{env}}/{{slot}}",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Server error rate (5xx)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (env, slot) (rate(http_requests_total{job=\"scoring-api\",handler=\"/v1/score\",status=\"5xx\"}[5m])) / sum by (env, slot) (rate(http_requests_total{job=\"scoring-api\",handler=\"/v1/score\"}[5m]))",
          "legendFormat": "{{env}}/{{slot}}",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "p95 latency",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (env, slot, le) (rate(http_request_duration_seconds_bucket{job=\"scoring-api\",handler=\"/v1/score\"}[5m])))",
          "legendFormat": "{{env}}/{{slot}}",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Mean predicted PD vs training baseline (model owner)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (env) (rate(scoring_prediction_score_sum[15m])) / sum by (env) (rate(scoring_prediction_score_count[15m]))",
          "legendFormat": "live {{env}}",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        },
        {
          "refId": "B",
          "expr": "avg by (env) (scoring_baseline_mean_score)",
          "legendFormat": "baseline {{env}}",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Memory per container (quota 512 MiB)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"scoring-api\"}",
          "legendFormat": "{{env}}/{{slot}}",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "CPU per container (quota 2 cores)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{job=\"scoring-api\"}[5m])",
          "legendFormat": "{{env}}/{{slot}}",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Firing alerts",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 28, "w": 24, "h": 6},
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\"}",
          "format": "table",
          "instant": true,
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ]
    }
  ]
}
